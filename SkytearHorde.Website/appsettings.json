{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "SixLabors.ImageSharp.Web.Middleware.ImageSharpMiddleware": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "8e5db82b-989c-4fba-a020-ffb089b721b0",
        "SanitizeTinyMce": true
      },
      "Cache": {
        "ContentTypeKeys": [
          "697f9eee-fb74-4125-97f3-4c9acf9f76c4",
          "ebabda05-0d18-4a65-9315-e9b87b4d058b",
          "aef42295-87d1-4b08-9794-7ab15bef4e33",
          "ff9dfcbf-b279-4ac6-a0ad-bec0faf5a509",
          "7db532af-67db-432e-b772-778adacc7b93"
        ]
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeManual",
        "ModelsNamespace": "SkytearHorde.Entities.Generated",
        "ModelsDirectory": "~/../SkytearHorde.Entities/Generated",
        "AcceptUnsafeModelsDirectory": true
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "DisallowedContentTypeAliases": [ "cardAttributeContainer", "cardContainer", "contentCreatorContainer", "data", "setContainer", "variantsContainer", "card", "cardVariant", "contentCreatorItem", "variant", "adSettings", "cardSettings", "collectionSettings", "deckSettings", "discordSettings", "settings", "siteSettings" ]
      }
    }
  },
  "uSync": {
    "Settings": {
      "ExportOnSave": "Settings",
      "UIEnabledGroups": "Settings"
    }
  },
  "SproutForms": {
    "Headless": {
      "Enabled": true,
      "AllowedOrigins": [ "https://sw-unlimited-db.com", "https://aidalon-db.com", "https://singularity-db.com", "https://localhost" ]
    }
  },
  "SeoToolkit": {
    "Global": {
      "EnableSeoSettingsByDefault": true,
      "EnableApiEndpoints": true,
      "AutomaticSitemapsInRobotsTxt": false
    }
  },
  "Slimsy": {
    "UseCropAsSrc": true,
    "DefaultQuality": 70,
    "TagHelper": {
      "DefaultPictureSources": [
        {
          "Extension": "webp",
          "Quality": 70
        }
      ],
      "ImageDimensions": true
    },
    "WidthStep": 320
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=localhost;Database=skytearhordedb_backup2;Integrated Security=true;TrustServerCertificate=true",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "CardImport": {
    "PromptsPath": "\\CardImport\\prompts\\",
    "StagingPath": "\\CardImport\\staging\\"
  }
}