<?xml version="1.0" encoding="utf-8"?>
<DataType Key="39746aeb-42b9-4b4b-a21a-434ae48d2031" Alias="Block List - Sort Options" Level="1">
  <Info>
    <Name>Block List - Sort Options</Name>
    <EditorAlias>Umbraco.BlockList</EditorAlias>
    <EditorUIAlias>Umb.PropertyEditorUi.BlockList</EditorUIAlias>
  </Info>
  <Config><![CDATA[{
  "blocks": [
    {
      "contentElementTypeKey": "d6ee9faa-2675-4ea9-83da-bdf5a92c558d",
